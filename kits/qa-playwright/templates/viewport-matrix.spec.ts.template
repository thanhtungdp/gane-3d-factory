import { expect, test } from "@playwright/test";

// Đổi các test ID/selector theo dự án mới.
const CTA = '[data-testid="game-dock"] [data-testid="continue"]';
const VIEWPORTS = [
  { width: 320, height: 640 },
  { width: 344, height: 882 },
  { width: 390, height: 844 },
  { width: 540, height: 720 },
  { width: 725, height: 870 },
  { width: 884, height: 1104 },
  { width: 1024, height: 600 },
  { width: 1440, height: 900 },
];

test("CTA luôn nằm trong viewport, không tràn ngang", async ({ page }) => {
  for (const viewport of VIEWPORTS) {
    await page.setViewportSize(viewport);
    await page.goto("/?intro=0");
    await expect(page.getByTestId("game-root")).toBeVisible();

    const cta = page.locator(CTA).first();
    await expect(cta).toBeVisible();
    const box = await cta.boundingBox();
    expect(box).toBeTruthy();
    expect(box!.y + box!.height).toBeLessThanOrEqual(viewport.height + 1);

    const overflow = await page.evaluate(() => document.documentElement.scrollWidth - window.innerWidth);
    expect(overflow).toBeLessThanOrEqual(1);
  }
});
