# ── Server ───────────────────────────────────────────────────────────────
PORT=8788
HOST=127.0.0.1
PUBLIC_ORIGIN=http://127.0.0.1:5173
DATA_DIR=.data
# Salt để hash IP (không lưu IP thô). Đổi ở production.
IP_HASH_SALT=doi-salt-nay-o-production
# 1 nếu chạy sau reverse proxy đã set X-Forwarded-For
TRUST_PROXY=0
# Host bind (sau proxy/Docker có thể để 0.0.0.0)
HOST=127.0.0.1
# Link đặt lịch dùng trong PDF/CTA (rỗng → dùng PUBLIC_ORIGIN)
BOOKING_URL=
# Token ký link PDF (rỗng → dùng IP_HASH_SALT; nên đặt riêng ở production)
PDF_TOKEN_SECRET=
# Hạn của link PDF, mili-giây (mặc định 7 ngày)
PDF_TOKEN_TTL_MS=604800000
# Giới hạn crawl: timeout mỗi request và số byte HTML tối đa
CRAWL_TIMEOUT_MS=8000
CRAWL_MAX_HTML_BYTES=2097152

# ── AI (tùy chọn) ────────────────────────────────────────────────────────
# Không có key → báo cáo dùng 3 insight template, không lỗi.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── CRM (tùy chọn) ───────────────────────────────────────────────────────
# Không có webhook → lead vẫn lưu SQLite + export CSV.
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=
# Timeout webhook CRM và số lần thử trước khi dead-letter (backoff 30s × 2^n)
CRM_WEBHOOK_TIMEOUT_MS=5000
CRM_MAX_ATTEMPTS=5
ADMIN_TOKEN=doi-token-admin-o-production

# ── Client (Vite chỉ expose biến VITE_*) ────────────────────────────────
VITE_BOOKING_URL=
VITE_SITE_ORIGIN=http://127.0.0.1:5173
VITE_SHOW_PRICE=1
VITE_ENABLE_LEADERBOARD=1
